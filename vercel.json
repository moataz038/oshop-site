{
  "buildCommand": "bash tools/build.sh && mkdir -p .vercel/output && cp -R vercel-output/. .vercel/output/",
  "framework": null,
  "outputDirectory": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/kb-badge-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin-login.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kb-badge-admin",
      "destination": "/api/staff/kb-badge-admin",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ]
    },
    {
      "source": "/kb-badge-admin-login.html",
      "destination": "/api/kb-badge-admin/assets/login-html"
    },
    {
      "source": "/kb-badge-admin-login.js",
      "destination": "/api/kb-badge-admin/assets/login-js"
    },
    {
      "source": "/kb-badge-admin.js",
      "destination": "/api/kb-badge-admin/assets/panel-js"
    },
    {
      "source": "/admin-login.html",
      "destination": "/api/legacy-admin/login-page"
    },
    {
      "source": "/admin-login.js",
      "destination": "/api/legacy-admin/login-script"
    }
  ]
}
