{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Strict-Transport-Security": "max-age=31536000",
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(self), geolocation=()",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
      },
      "continue": true
    },
    {
      "src": "^/(?:kb-badge-admin[^/]*(?:/.*)?|api/(?:kb-badge-admin(?:/.*)?|staff/kb-badge-(?:admin|copy)(?:/.*)?))$",
      "caseSensitive": false,
      "missing": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ],
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/(?:admin-login(?:\\.html|\\.js)?(?:/.*)?|api/admin(?:/.*)?|api/legacy-admin(?:/.*)?)$",
      "caseSensitive": false,
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-online-store.vercel.app"
          }
        }
      ],
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/(.*)$",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ],
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      },
      "continue": true
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ],
      "status": 302,
      "headers": {
        "Location": "/kb-badge-admin",
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/kb-badge-admin/?$",
      "caseSensitive": false,
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ],
      "dest": "/api/staff/kb-badge-admin",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/kb-badge-admin-login\\.html$",
      "caseSensitive": false,
      "dest": "/api/kb-badge-admin/assets/login-html",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/kb-badge-admin-login\\.js$",
      "caseSensitive": false,
      "dest": "/api/kb-badge-admin/assets/login-js",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/kb-badge-admin\\.js$",
      "caseSensitive": false,
      "dest": "/api/kb-badge-admin/assets/panel-js",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/admin-login\\.html$",
      "caseSensitive": false,
      "dest": "/api/legacy-admin/login-page",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/admin-login\\.js$",
      "caseSensitive": false,
      "dest": "/api/legacy-admin/login-script",
      "check": true,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/(?!(?:kb-badge-admin/?|kb-badge-admin-login\\.html|kb-badge-admin-login\\.js|kb-badge-admin\\.js|api/(?:staff/kb-badge-(?:admin|copy)/?|kb-badge-admin/(?:login|logout)/?|kb-badge-admin/assets/(?:login-html|login-js|panel-js)))$).*$",
      "caseSensitive": false,
      "has": [
        {
          "type": "host",
          "value": {
            "eq": "kb-badge-admin.vercel.app"
          }
        }
      ],
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/api(/.*)?$",
      "dest": "/api"
    },
    {
      "handle": "filesystem"
    }
  ]
}
